# API
PORT=3000
LOG_LEVEL=info

# Database (used when running locally without Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=industrial
DB_PASSWORD=industrial
DB_NAME=industrial_events
DATABASE_URL=postgresql://industrial:industrial@localhost:5432/industrial_events

# When using Docker Compose the service name `db` is used as host.

# -- Pool de Postgres ---------------------------------------------------------
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# -- Limites de consulta ------------------------------------------------------
EVENTS_DEFAULT_LIMIT=100
EVENTS_MAX_LIMIT=1000

# -- Cache en proceso para /events/latest y el catalogo -----------------------
CACHE_ENABLED=true
CACHE_LATEST_TTL_MS=1500
CACHE_CATALOG_TTL_MS=60000
CACHE_MAX_ENTRIES=2000

# -- Rate limit por API key (ventana fija en memoria) -------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX=50

# -- Bus de tools nativas dentro del POST /events -----------------------------
BUS_CHAIN_TIMEOUT_MS=8000

# -- Apagado ordenado ---------------------------------------------------------
SHUTDOWN_GRACE_MS=10000
